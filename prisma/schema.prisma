// BCSK Platform data model (SRS §7)
// PostgreSQL — works with Vercel Postgres/Neon (deployment) and `npx prisma dev` (local).
// The types below are also MySQL-compatible if the school later self-hosts per the SRS.
// Role/status/type fields are strings validated against constants in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) endpoint — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Unpooled endpoint — Prisma Migrate needs a direct session-mode connection,
  // which Neon's transaction-mode pooler cannot provide.
  directUrl = env("DIRECT_URL")
}

// Uploaded files live in the database so the app runs on serverless hosts
// (no writable filesystem on Vercel). Served role-checked via /api/files/[...path].
model FileBlob {
  path      String   @id // e.g. "applications/ab12cd.jpg"
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

/**
 * A school using the platform. Every account and every top-level academic record belongs to
 * one, and a staff member only ever sees their own institute's rows (`common/institute-scope.ts`).
 * One row today - BCSK, id 1, inserted by the migration - so the `@default(1)` on the owning
 * columns files rows made by public flows (admission activation) and the seeds under it.
 */
model Institute {
  id                  Int                   @id @default(autoincrement())
  code                String                @unique // short stable key: BCSK
  name                String
  nameBn              String?
  nameKo              String?
  address             String?
  phone               String?
  email               String?
  website             String?
  logoUrl             String?
  headMasterName      String? // printed under the signature on reports and certificates
  signatureUrl        String?
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  users               User[]
  courses             Course[]
  departments         Department[]
  terms               AcademicTerm[]
  subjects            Subject[]
  calendarEvents      CalendarEvent[]
  gradingSchemes      GradingScheme[]
  exams               Exam[]
  templates           DocumentTemplate[]
  // How equal results are ranked (LMS B5): SHARED gives both the same place and skips the next
  // (1, 1, 3); SPLIT orders them by total marks, then roll number (1, 2, 3).
  rankTies            String                @default("SHARED")
  // Leave a class teacher may approve alone, in days (LMS B6). 0: every leave goes to the Head Master.
  leaveTeacherMaxDays Int                   @default(0)
  leaves              LeaveApplication[]
  transfers           TransferApplication[]
}

/**
 * -------------------------------------------------------- leave and transfer (LMS B6)
 */

/**
 * A student's leave request. PENDING -> REVIEWED (class teacher recommends) -> APPROVED or
 * REJECTED (Head Master; or the class teacher alone for leave of at most the institute's
 * `leaveTeacherMaxDays`). The student may CANCEL until it is decided. Approval marks the
 * student's classes on those days EXCUSED.
 */
model LeaveApplication {
  id             Int       @id @default(autoincrement())
  instituteId    Int
  institute      Institute @relation(fields: [instituteId], references: [id])
  studentUserId  Int
  student        User      @relation("StudentLeaves", fields: [studentUserId], references: [id], onDelete: Cascade)
  sectionId      Int? // the section at the time, which decides the class teacher
  fromDate       DateTime // school days at midnight UTC, both inclusive
  toDate         DateTime
  days           Int
  reason         String
  attachmentUrl  String? // a doctor's note, under leave/
  status         String    @default("PENDING") // PENDING | REVIEWED | APPROVED | REJECTED | CANCELLED
  recommendation String? // APPROVE | REJECT, the class teacher's
  reviewedById   Int?
  reviewedAt     DateTime?
  reviewNote     String?
  decidedById    Int?
  decidedAt      DateTime?
  decisionNote   String?
  excusedMarks   Int       @default(0) // attendance marks set EXCUSED on approval
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([instituteId, status])
  @@index([studentUserId])
  @@index([sectionId, status])
}

/**
 * A student's transfer out. SUBMITTED -> VERIFIED (the office has cleared dues and library) ->
 * APPROVED (Head Master: the letter is issued, the student is marked TRANSFERRED and leaves
 * their sections) or REJECTED. The student may CANCEL until it is decided.
 */
model TransferApplication {
  id             Int       @id @default(autoincrement())
  instituteId    Int
  institute      Institute @relation(fields: [instituteId], references: [id])
  studentUserId  Int
  student        User      @relation("StudentTransfers", fields: [studentUserId], references: [id], onDelete: Cascade)
  sectionId      Int?
  destination    String // the school the student is moving to
  reason         String
  effectiveDate  DateTime
  status         String    @default("SUBMITTED") // SUBMITTED | VERIFIED | APPROVED | REJECTED | CANCELLED
  duesCleared    Boolean   @default(false)
  libraryCleared Boolean   @default(false)
  verifiedById   Int?
  verifiedAt     DateTime?
  verifyNote     String?
  decidedById    Int?
  decidedAt      DateTime?
  decisionNote   String?
  letterSerial   String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([instituteId, status])
  @@index([studentUserId])
}

/**
 * ------------------------------------------------------- results and documents (LMS B5)
 */

/**
 * The results of one exam for one section, as a unit of approval:
 * PROCESSED (computed from submitted marks) -> APPROVED (marks locked) -> PUBLISHED (students
 * see them). RETURNED sends the section's marks back to its teachers. A published section can be
 * withdrawn by the Head Master, back to APPROVED, with a reason.
 */
model SectionResult {
  id            Int       @id @default(autoincrement())
  examId        Int
  exam          Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionId     Int
  section       Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status        String    @default("PROCESSED") // PROCESSED | APPROVED | RETURNED | PUBLISHED
  processedAt   DateTime  @default(now())
  processedById Int?
  approvedById  Int?
  approvedAt    DateTime?
  publishedById Int?
  publishedAt   DateTime?
  note          String? // why it was returned or withdrawn
  updatedAt     DateTime  @updatedAt

  @@unique([examId, sectionId])
}

/**
 * One student's result in one exam: totals, GPA or overall grade, and places.
 */
model ResultSummary {
  id              Int          @id @default(autoincrement())
  examId          Int
  exam            Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionId       Int
  studentUserId   Int
  student         User         @relation("StudentResults", fields: [studentUserId], references: [id], onDelete: Cascade)
  rollNo          Int?
  totalObtained   Float
  totalFull       Int
  percent         Float
  gpa             Float? // null for a letter scheme
  grade           String
  passed          Boolean
  failedSubjects  Int
  sectionPosition Int?
  classPosition   Int?
  // Held back from this one student (unpaid dues, a disciplinary case) while the section publishes.
  // Survives re-processing; places are still computed, so releasing it later changes nobody else's.
  withheld        Boolean      @default(false)
  withheldReason  String?
  withheldAt      DateTime?
  withheldById    Int?
  createdAt       DateTime     @default(now())
  lines           ResultLine[]

  @@unique([examId, studentUserId])
  @@index([examId, sectionId])
  @@index([studentUserId])
}

/**
 * One subject of a student's result, frozen at processing so a later edit never changes it.
 */
model ResultLine {
  id          Int           @id @default(autoincrement())
  summaryId   Int
  summary     ResultSummary @relation(fields: [summaryId], references: [id], onDelete: Cascade)
  paperId     Int
  subjectName String
  fullMarks   Int
  passMarks   Int
  obtained    Float?
  isAbsent    Boolean       @default(false)
  percent     Float
  grade       String
  gradePoint  Float?
  passed      Boolean
  isOptional  Boolean       @default(false)

  @@index([summaryId])
}

/**
 * The wording of a printed document, per type and language, editable by the Head Master so the
 * school changes a certificate's text without a deploy. `body` may use the placeholders listed
 * in `documents/templates.ts`, such as {{name}} and {{class}}.
 */
model DocumentTemplate {
  id             Int       @id @default(autoincrement())
  instituteId    Int
  institute      Institute @relation(fields: [instituteId], references: [id])
  type           String // COMPLETION | CHARACTER | ENROLLMENT | TRANSFER_LETTER | MARK_SHEET
  lang           String    @default("en") // en | bn | ko
  title          String
  body           String
  signatoryName  String?
  signatoryTitle String?
  updatedById    Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([instituteId, type, lang])
}

/**
 * ------------------------------------------------------------- exams and marks (LMS B4)
 */

/**
 * How a percentage becomes a grade. Each band holds its lower bound; it runs up to the next
 * band's, the top one to 100. One band must start at 0, so every percentage has a grade.
 * Bangladesh GPA 5.0 is seeded for the founding institute; a school may add its own.
 */
model GradingScheme {
  id          Int         @id @default(autoincrement())
  instituteId Int
  institute   Institute   @relation(fields: [instituteId], references: [id])
  name        String
  kind        String      @default("GPA") // GPA (grade points) | LETTER (letters only)
  isDefault   Boolean     @default(false) // at most one per institute; the service keeps it so
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  bands       GradeBand[]
  exams       Exam[]

  @@unique([instituteId, name])
}

model GradeBand {
  id         Int           @id @default(autoincrement())
  schemeId   Int
  scheme     GradingScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  minPercent Float
  grade      String // A+, A, A-, ... F
  gradePoint Float? // 5.0 .. 0.0 for a GPA scheme
  passing    Boolean       @default(true)
  remark     String? // "Outstanding", "Fail"

  @@unique([schemeId, minPercent])
}

/**
 * An examination of a term - "Half-yearly 2026" - sat by the classes its papers name.
 */
model Exam {
  id              Int             @id @default(autoincrement())
  instituteId     Int
  institute       Institute       @relation(fields: [instituteId], references: [id])
  termId          Int
  term            AcademicTerm    @relation(fields: [termId], references: [id])
  name            String
  type            String          @default("TERM") // CLASS_TEST | MIDTERM | TERM | FINAL | MODEL
  gradingSchemeId Int
  gradingScheme   GradingScheme   @relation(fields: [gradingSchemeId], references: [id])
  status          String          @default("DRAFT") // DRAFT | SCHEDULED | CANCELLED (results: ResultApproval, B5)
  instructions    String?
  calendarEventId Int? // the EXAM entry made when the schedule is published
  createdById     Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  papers          ExamPaper[]
  sectionResults  SectionResult[]
  summaries       ResultSummary[]

  @@unique([instituteId, termId, name])
  @@index([termId, status])
}

/**
 * One subject's paper of an exam for one class, on a date: what students sit and teachers mark.
 */
model ExamPaper {
  id            Int             @id @default(autoincrement())
  examId        Int
  exam          Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  courseLevelId Int
  courseLevel   CourseLevel     @relation(fields: [courseLevelId], references: [id])
  subjectId     Int
  subject       Subject         @relation(fields: [subjectId], references: [id])
  date          DateTime // a school day at midnight UTC, like attendance
  startTime     String
  endTime       String
  room          String?
  fullMarks     Int
  passMarks     Int
  examinerId    Int? // TeacherProfile.id: may mark every section's scripts
  examiner      TeacherProfile? @relation("Examiner", fields: [examinerId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sheets        MarkSheet[]
  marks         Mark[]

  @@unique([examId, courseLevelId, subjectId])
  @@index([courseLevelId, date])
  @@index([date]) // LMS B7: paper clash checks across classes
}

/**
 * One section's marks for one paper, as a unit of work: a teacher fills it (DRAFT), submits it
 * (SUBMITTED - no more edits), and only the Head Master can reopen it, with a reason, audited.
 * LOCKED (results approved, B5) cannot be reopened.
 */
model MarkSheet {
  id            Int       @id @default(autoincrement())
  paperId       Int
  paper         ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  sectionId     Int
  section       Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  status        String    @default("DRAFT") // DRAFT | SUBMITTED | LOCKED
  submittedById Int?
  submittedAt   DateTime?
  reopenedById  Int?
  reopenedAt    DateTime?
  reopenReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([paperId, sectionId])
  @@index([sectionId])
}

model Mark {
  id            Int       @id @default(autoincrement())
  paperId       Int
  paper         ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  studentUserId Int
  student       User      @relation("StudentMarks", fields: [studentUserId], references: [id], onDelete: Cascade)
  sectionId     Int
  obtained      Float? // null with isAbsent; otherwise 0..fullMarks
  isAbsent      Boolean   @default(false)
  enteredById   Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([paperId, studentUserId])
  @@index([sectionId, paperId])
  @@index([studentUserId])
}

/**
 * ------------------------------------------------- calendar and online classes (LMS B2)
 */

/**
 * An entry on the academic calendar: term dates, holidays, exam weeks, events. Dates are whole
 * days in school time (Asia/Seoul) stored at midnight UTC, end inclusive. Draft until published;
 * a class-specific entry (`courseLevelId`) is shown only to that class's students.
 */
model CalendarEvent {
  id            Int           @id @default(autoincrement())
  instituteId   Int
  institute     Institute     @relation(fields: [instituteId], references: [id])
  termId        Int?
  term          AcademicTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  courseLevelId Int?
  courseLevel   CourseLevel?  @relation(fields: [courseLevelId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          String // TERM | HOLIDAY | EXAM | EVENT | MEETING
  audience      String        @default("ALL") // ALL | STUDENTS | TEACHERS | STAFF
  startDate     DateTime
  endDate       DateTime
  published     Boolean       @default(false)
  createdById   Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([instituteId, startDate])
}

/**
 * One meeting of a class online: when it runs, its link, and whether it is scheduled, live,
 * over or cancelled. The routine slot (`ClassSession`) is the weekly pattern; this is a date.
 * The link is handed out only through the join endpoint, which logs who joined.
 */
model OnlineClass {
  id             Int               @id @default(autoincrement())
  classSessionId Int
  classSession   ClassSession      @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  topic          String?
  startsAt       DateTime
  endsAt         DateTime
  joinUrl        String?
  status         String            @default("SCHEDULED") // SCHEDULED | LIVE | ENDED | CANCELLED
  startedAt      DateTime?
  endedAt        DateTime?
  recordingUrl   String?
  createdById    Int?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  joins          OnlineClassJoin[]

  @@index([classSessionId, startsAt])
  @@index([status, startsAt])
}

/**
 * A course material (LMS B3): a file, a link or a video for one subject of one class - for every
 * section of the class (`sectionId` null, set by the Head Master) or for one section (set by a
 * teacher of that subject there). Students see the published ones for their own sections.
 */
model CourseMaterial {
  id            Int         @id @default(autoincrement())
  courseLevelId Int
  courseLevel   CourseLevel @relation(fields: [courseLevelId], references: [id], onDelete: Cascade)
  subjectId     Int
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId     Int?
  section       Section?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  kind          String // FILE | LINK | VIDEO
  fileUrl       String? // a stored path under materials/, for FILE
  linkUrl       String? // an https link, for LINK and VIDEO
  published     Boolean     @default(true)
  displayOrder  Int         @default(100)
  uploadedById  Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([courseLevelId, subjectId])
  @@index([sectionId])
}

/**
 * First time each person opened an online class's link.
 */
model OnlineClassJoin {
  id            Int         @id @default(autoincrement())
  onlineClassId Int
  onlineClass   OnlineClass @relation(fields: [onlineClassId], references: [id], onDelete: Cascade)
  userId        Int
  user          User        @relation("OnlineClassJoins", fields: [userId], references: [id], onDelete: Cascade)
  joinedAt      DateTime    @default(now())

  @@unique([onlineClassId, userId])
}

/**
 * ------------------------------------------------------------ academic structure (LMS B1)
 * Institute → Department → Course → class (CourseLevel) → Batch (class × term) → Section.
 * Regular schooling is one "Regular Course" whose levels are Pre-Primary..Class 5; a special
 * course (Abacus, IELTS) uses its own levels. Child tables are scoped to an institute through
 * their parent (a Batch through its term), never by a column of their own.
 */

model Department {
  id           Int       @id @default(autoincrement())
  instituteId  Int
  institute    Institute @relation(fields: [instituteId], references: [id])
  name         String
  code         String // short key, unique within the institute: GEN, DEEN
  headUserId   Int? // the teacher or staff member who leads it
  head         User?     @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)
  displayOrder Int       @default(100)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  courses      Course[]
  subjects     Subject[]

  @@unique([instituteId, code])
}

/**
 * A semester. `code` keeps the strings the older tables still key on (`ClassSession.semester`,
 * `Enrollment.semester`: "2026-2"), so they and this table name the same term.
 */
model AcademicTerm {
  id          Int             @id @default(autoincrement())
  instituteId Int
  institute   Institute       @relation(fields: [instituteId], references: [id])
  code        String
  name        String
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean         @default(false) // at most one per institute; the service keeps it so
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  batches     Batch[]
  events      CalendarEvent[]
  exams       Exam[]

  @@unique([instituteId, code])
  @@index([instituteId, isCurrent])
}

/**
 * One class in one term: "Class 3, 2026-2". Its sections divide the students.
 */
model Batch {
  id            Int                 @id @default(autoincrement())
  courseLevelId Int
  courseLevel   CourseLevel         @relation(fields: [courseLevelId], references: [id], onDelete: Cascade)
  termId        Int
  term          AcademicTerm        @relation(fields: [termId], references: [id], onDelete: Cascade)
  name          String
  createdAt     DateTime            @default(now())
  sections      Section[]
  enrollments   SectionEnrollment[]

  @@unique([courseLevelId, termId])
  @@index([termId])
}

model Section {
  id             Int                 @id @default(autoincrement())
  batchId        Int
  batch          Batch               @relation(fields: [batchId], references: [id], onDelete: Cascade)
  name           String // A, B
  capacity       Int?
  room           String? // a room, or "Online"
  classTeacherId Int? // TeacherProfile.id
  classTeacher   TeacherProfile?     @relation("ClassTeacher", fields: [classTeacherId], references: [id], onDelete: SetNull)
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  enrollments    SectionEnrollment[]
  assignments    TeacherAssignment[]
  sessions       ClassSession[]
  materials      CourseMaterial[]
  markSheets     MarkSheet[]
  results        SectionResult[]

  @@unique([batchId, name])
  @@index([classTeacherId])
}

/**
 * What is taught and examined: Bangla, Mathematics, Abacus. Marks rules live per class in `CurriculumSubject`.
 */
model Subject {
  id           Int                 @id @default(autoincrement())
  instituteId  Int
  institute    Institute           @relation(fields: [instituteId], references: [id])
  departmentId Int?
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  code         String // unique within the institute: BAN, MATH, ABACUS
  name         String
  type         String              @default("THEORY") // THEORY | PRACTICAL
  displayOrder Int                 @default(100)
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  curriculum   CurriculumSubject[]
  assignments  TeacherAssignment[]
  sessions     ClassSession[]
  materials    CourseMaterial[]
  examPapers   ExamPaper[]

  @@unique([instituteId, code])
}

/**
 * A subject as taught in one class, with the marks rules its exams use.
 */
model CurriculumSubject {
  id            Int         @id @default(autoincrement())
  courseLevelId Int
  courseLevel   CourseLevel @relation(fields: [courseLevelId], references: [id], onDelete: Cascade)
  subjectId     Int
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  fullMarks     Int         @default(100)
  passMarks     Int         @default(33)
  isOptional    Boolean     @default(false)
  displayOrder  Int         @default(100)

  @@unique([courseLevelId, subjectId])
  @@index([subjectId])
}

/**
 * A student's place in a section. One per batch - a student is in one section of Class 3 for
 * a term, and may separately be in a section of Abacus Level 2. `batchId` repeats the section's
 * batch so the database can hold that rule.
 */
model SectionEnrollment {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  student       User     @relation("SectionStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  sectionId     Int
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  batchId       Int
  batch         Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rollNo        Int?
  status        String   @default("ACTIVE") // ACTIVE | COMPLETED | TRANSFERRED | LEFT
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentUserId, batchId])
  @@unique([sectionId, rollNo])
  @@index([sectionId, status])
}

/**
 * Who teaches which subject to which section. The class teacher is `Section.classTeacherId`.
 */
model TeacherAssignment {
  id               Int            @id @default(autoincrement())
  teacherProfileId Int
  teacher          TeacherProfile @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  sectionId        Int
  section          Section        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subjectId        Int
  subject          Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([teacherProfileId, sectionId, subjectId])
  @@index([sectionId, subjectId])
}

model User {
  id                 Int       @id @default(autoincrement())
  instituteId        Int       @default(1)
  institute          Institute @relation(fields: [instituteId], references: [id])
  loginId            String    @unique // Student ID / Teacher ID / Admin ID
  email              String?
  passwordHash       String
  role               String // STUDENT | TEACHER | HEAD_MASTER | ADMIN_SUPPORT | IT_SUPPORT | SUPER_ADMIN
  name               String
  langPref           String    @default("en") // en | bn | ko
  active             Boolean   @default(true)
  // SEC-2: set on seeded/rotated/office-issued credentials. Every surface guard
  // diverts to /change-password until the holder sets their own password.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  studentProfile   StudentProfile?
  teacherProfile   TeacherProfile?
  enrollments      Enrollment[]
  attendances      Attendance[]
  submissions      Submission[]
  payments         Payment[]             @relation("PayerPayments")
  verifiedPayments Payment[]             @relation("VerifierPayments")
  notifications    Notification[]
  questionsAsked   Question[]            @relation("StudentQuestions")
  questionsRecv    Question[]            @relation("TeacherQuestions")
  teacherTasks     TeacherTask[]
  certificates     Certificate[]
  progressRecords  ProgressRecord[]
  gameScores       GameScore[]
  hifzProgress     HifzProgress[]
  examResults      ExamResult[]
  auditLogs        AuditLog[]
  passwordResets   PasswordReset[]
  refreshTokens    RefreshToken[]
  assignedLeads    Lead[]                @relation("LeadOwner")
  leadActivities   LeadActivity[]
  menuPermissions  UserMenuPermission[]
  departmentsLed   Department[]          @relation("DepartmentHead")
  sectionPlaces    SectionEnrollment[]   @relation("SectionStudent")
  onlineJoins      OnlineClassJoin[]     @relation("OnlineClassJoins")
  marks            Mark[]                @relation("StudentMarks")
  resultSummaries  ResultSummary[]       @relation("StudentResults")
  leaves           LeaveApplication[]    @relation("StudentLeaves")
  transfers        TransferApplication[] @relation("StudentTransfers")

  @@index([instituteId, role])
}

/**
 * Phase F: refresh tokens for mobile clients.
 * Stored **hashed** — a database leak must not yield usable credentials. Rotated on every
 * use; presenting an already-rotated token revokes the whole family, which is the standard
 * signal that a token was stolen.
 */
model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  /**
   * Groups rotations of one login, so a reuse can revoke every descendant.
   */
  familyId   String
  deviceName String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordReset {
  id        Int       @id @default(autoincrement())
  userId    Int
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentProfile {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique
  studentId          String    @unique // e.g. BCSK-2026-0001
  classLevel         String // PRE_PRIMARY | CLASS_1..CLASS_5 | SPECIAL
  photoUrl           String?
  dob                DateTime?
  gender             String?
  religion           String?
  fatherName         String?
  motherName         String?
  guardianProfession String?
  guardianEducation  String?
  guardianPhone      String?
  guardianEmail      String?
  addressKorea       String?
  addressBangladesh  String?
  emergencyContact   String?
  admissionDate      DateTime? // set when the admission is activated
  status             String    @default("ACTIVE") // ACTIVE | TRANSFERRED | LEFT | GRADUATED
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id             Int                 @id @default(autoincrement())
  userId         Int                 @unique
  teacherId      String              @unique // e.g. BCSK-T-001
  designation    String?
  bio            String?
  photoUrl       String?
  guideClass     String? // guide-teacher class
  subjects       String? // comma-separated for display
  isPublic       Boolean             @default(true) // show on public Teachers page and the homepage office board
  // Homepage office board (LP-2). `deskStatus` is what a teacher toggles about themselves;
  // "in class" is never stored here - it is derived from owning a live ClassSession, so the
  // office board can never contradict the classroom board.
  deskName       String? // board label where one teacher holds a named desk: "English-1", "Quran-Female"
  deskStatus     String              @default("OFFLINE") // DESK | OFFLINE
  returnAt       DateTime? // when they expect to be back at the desk; null renders as "-"
  displayOrder   Int                 @default(100)
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSessions  ClassSession[]
  sectionsLed    Section[]           @relation("ClassTeacher")
  assignments    TeacherAssignment[]
  papersExamined ExamPaper[]         @relation("Examiner")
}

model Course {
  id           Int            @id @default(autoincrement())
  instituteId  Int            @default(1)
  institute    Institute      @relation(fields: [instituteId], references: [id])
  departmentId Int?
  department   Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  slug         String         @unique // bangla, english, math, abacus, ielts-for-kids, deen, debate-club, hifz, bangla-language
  name         String
  type         String // REGULAR | SPECIAL
  category     String? // subject | deen | ielts | abacus | debate
  description  String?
  heroText     String?
  active       Boolean        @default(true)
  displayOrder Int            @default(100)
  levels       CourseLevel[]
  sessions     ClassSession[]
  fees         FeeConfig[]
  leads        Lead[]

  @@index([instituteId])
}

model CourseLevel {
  id             Int                 @id @default(autoincrement())
  courseId       Int
  name           String // "Level 0" .. "Level 7", "Pre-Primary", track names
  code           String? // stable key for the levels other tables still name as text: PRE_PRIMARY, CLASS_1..CLASS_5
  displayOrder   Int                 @default(0)
  syllabus       String? // markdown/plain topic coverage
  studentBookUrl String?
  workBookUrl    String?
  course         Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions       ClassSession[]
  applications   ApplicationForm[]
  fees           FeeConfig[]
  batches        Batch[]
  curriculum     CurriculumSubject[]
  calendarEvents CalendarEvent[]
  materials      CourseMaterial[]
  examPapers     ExamPaper[]

  @@unique([courseId, code])
  @@index([courseId, displayOrder])
}

model ClassSession {
  id            Int             @id @default(autoincrement())
  courseId      Int
  courseLevelId Int?
  title         String // e.g. "Level-0 Class-1", "Class 3 – Bangla"
  classLevel    String? // for regular classes: PRE_PRIMARY..CLASS_5
  dayOfWeek     String // e.g. "Saturday"
  startTime     String // "10:00"
  endTime       String? // "11:00"
  semester      String          @default("2026-2")
  // LMS B1: the section and subject this slot teaches. Null on slots the backfill could not place.
  sectionId     Int?
  section       Section?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  subjectId     Int?
  subject       Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacherId     Int?
  zoomLink      String?
  isLive        Boolean         @default(false)
  liveSince     DateTime? // set when isLive flips on, cleared when it flips off - the board duration
  notice        String?
  room          String? // LMS B2: a room for in-person slots; checked for double booking
  active        Boolean         @default(true)
  course        Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level         CourseLevel?    @relation(fields: [courseLevelId], references: [id])
  teacher       TeacherProfile? @relation(fields: [teacherId], references: [id])
  enrollments   Enrollment[]
  attendances   Attendance[]
  assignments   Assignment[]
  videos        ClassVideo[]
  onlineClasses OnlineClass[]

  @@index([courseId])
  @@index([courseLevelId])
  @@index([teacherId])
  @@index([classLevel, semester, active])
  @@index([semester, active])
  @@index([sectionId])
  @@index([semester, dayOfWeek, active]) // LMS B7: routine clash checks and the day's classes
}

model Enrollment {
  id             Int          @id @default(autoincrement())
  studentUserId  Int
  classSessionId Int
  semester       String
  status         String       @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt      DateTime     @default(now())
  student        User         @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, classSessionId, semester])
  @@index([classSessionId])
  @@index([studentUserId, semester, status])
}

model Attendance {
  id             Int          @id @default(autoincrement())
  classSessionId Int
  studentUserId  Int
  date           DateTime
  status         String // PRESENT | ABSENT | LATE | EXCUSED (EXCUSED: approved leave, LMS B6)
  remark         String?
  markedById     Int? // who last wrote this row (LMS B3); null on rows from before
  updatedAt      DateTime     @default(now()) @updatedAt
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentUserId, date])
  @@index([studentUserId, date])
  @@index([classSessionId, date])
  @@index([date]) // LMS B7: institute-wide attendance over a range
}

model Assignment {
  id             Int          @id @default(autoincrement())
  classSessionId Int
  title          String
  description    String?
  fileUrl        String?
  dueDate        DateTime?
  maxMarks       Int? // LMS B3: when set, a grade carries numeric marks out of this
  createdById    Int?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  submissions    Submission[]

  @@index([classSessionId, createdAt])
}

model Submission {
  id            Int        @id @default(autoincrement())
  assignmentId  Int
  studentUserId Int
  fileUrl       String?
  text          String?
  submittedAt   DateTime   @default(now())
  grade         String?
  marks         Float? // LMS B3: out of the assignment's maxMarks
  feedback      String?
  gradedAt      DateTime?
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       User       @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentUserId])
  @@index([studentUserId])
}

model ClassVideo {
  id             Int          @id @default(autoincrement())
  classSessionId Int
  title          String
  videoUrl       String // uploaded file or YouTube/Zoom recording link
  recordedAt     DateTime     @default(now())
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([classSessionId, recordedAt])
}

model ApplicationForm {
  id                    Int          @id @default(autoincrement())
  type                  String // REGULAR | SPECIAL | RE_ADMISSION - every registration lands in this one table
  status                String       @default("PENDING_PAYMENT") // PENDING_PAYMENT | PENDING_VERIFICATION | PAID | APPROVED | REJECTED | CORRECTIONS_REQUESTED
  // shared applicant fields
  applicantName         String // "First Last"; kept whole because re-admission and activation key on it
  firstName             String?
  lastName              String?
  dob                   DateTime?
  gender                String?
  religion              String?
  phone                 String?
  email                 String?
  photoUrl              String?
  addressKorea          String?
  addressBangladesh     String?
  emergencyContact      String? // "Name, phone" - the two columns below hold the parts
  emergencyContactName  String?
  emergencyContactPhone String?
  learningMode          String? // online | hybrid
  // re-admission: the returning student's existing ID, verified against StudentProfile at submit
  studentId             String?
  semester              String? // the semester the registration is for
  // regular course
  grade                 String? // PRE_PRIMARY..CLASS_5
  fatherName            String?
  fatherEmail           String?
  fatherEducation       String?
  fatherProfession      String?
  fatherPhone           String?
  motherName            String?
  motherEmail           String?
  motherEducation       String?
  motherProfession      String?
  motherPhone           String?
  // Single-guardian columns from before father and mother were asked separately.
  guardianProfession    String?
  guardianEducation     String?
  guardianPhone2        String?
  presentQualification  String? // the class the student is in now (e.g. "Class 1, Korean school")
  // special course
  courseName            String? // slug of special course
  // The level or track the family chose (Abacus Level 2, Deen girls' Tajweed…). Activation
  // enrols into this level's classes; without it every special-course student used to land
  // in the course's first class. Null on applications made before the choice existed.
  courseLevelId         Int?
  courseLevel           CourseLevel? @relation(fields: [courseLevelId], references: [id], onDelete: SetNull)
  highestEducation      String?
  // SEC-3: the BCSK-student discount claim, persisted at submit time. The fee is derived
  // from this column and never from a request parameter.
  isBcskStudent         Boolean      @default(false)
  parentalConsent       Boolean      @default(false) // PIPA consent
  adminNote             String?
  correctionNote        String?
  // Staff-written, from the admission assessment
  assessorComment       String?
  paymentNote           String?
  createdStudentUserId  Int?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  payments              Payment[]
  leads                 Lead[]
  // Discount coupon, snapshotted at submit time. The payable amount is derived from these
  // columns and never from a request (SEC-3): editing or deleting the Coupon later does not
  // change what a family already holds.
  couponId              Int?
  coupon                Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode            String?
  couponType            String? // PERCENT | FIXED
  couponValue           Int? // percent (1-99) or KRW amount

  @@index([status, createdAt])
  @@index([type, createdAt])
}

model Payment {
  id               Int              @id @default(autoincrement())
  applicationId    Int?
  payerUserId      Int? // for logged-in semester fee / re-admission payments
  purpose          String // ADMISSION | SEMESTER_FEE | SPECIAL_COURSE | RE_ADMISSION
  method           String // CARD | BANK_TRANSFER
  amount           Int // KRW
  currency         String           @default("KRW")
  status           String           @default("PENDING") // PENDING | PENDING_VERIFICATION | PAID | VERIFIED | REJECTED | REFUNDED | FAILED
  // SEC-7.1: unique so a replayed gateway callback cannot record the same capture twice.
  gatewayTxnId     String?          @unique // Toss paymentKey
  gatewayOrderId   String?          @unique
  virtualRef       String?          @unique // auto-generated bank reference
  receiptUploadUrl String? // uploaded bank receipt
  receiptPdfSerial String?          @unique // our issued receipt number
  rejectReason     String?
  verifiedById     Int?
  verifiedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  application      ApplicationForm? @relation(fields: [applicationId], references: [id])
  payer            User?            @relation("PayerPayments", fields: [payerUserId], references: [id])
  verifiedBy       User?            @relation("VerifierPayments", fields: [verifiedById], references: [id])

  @@index([applicationId])
  @@index([payerUserId])
  @@index([verifiedById])
  @@index([status, createdAt])
}

model FeeConfig {
  id            Int          @id @default(autoincrement())
  key           String       @unique // pre_primary, class_1..class_5, abacus, deen, debate_club, abacus_l1 ...
  label         String
  kind          String // REGULAR_CLASS | SPECIAL_COURSE (course-wide default) | SPECIAL_LEVEL (one level of a course)
  // What this fee is for. A level's own row wins; a course-wide row (courseLevelId null) is the
  // default for a course without levels, and the fallback for a level with no row of its own.
  courseId      Int?
  courseLevelId Int?         @unique
  course        Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  level         CourseLevel? @relation(fields: [courseLevelId], references: [id], onDelete: SetNull)
  admissionFee  Int          @default(0)
  semesterFee   Int          @default(0)
  bcskPrice     Int? // special course price for BCSK students
  nonBcskPrice  Int? // for non-BCSK students
  bookFee       Int?
  displayOrder  Int          @default(100)
  active        Boolean      @default(true)

  @@index([courseId])
}

model ContentPage {
  id          Int      @id @default(autoincrement())
  slug        String // about-us, education-process, admission-process, ...
  lang        String   @default("en") // en | bn | ko
  title       String
  content     String // markdown
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  updatedById Int?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([slug, lang])
  @@index([slug, status])
}

model EventNews {
  id        Int      @id @default(autoincrement())
  type      String // NEWS | SEMINAR | EVENT
  title     String
  body      String
  imageUrl  String?
  date      DateTime @default(now())
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, date])
}

/**
 * The homepage hero slider. A flat, small (admin-capped at 5) list rather than a gallery
 * album — one purpose, one place, no nesting.
 */
model HeroImage {
  id           Int      @id @default(autoincrement())
  url          String
  caption      String?
  displayOrder Int      @default(100)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([active, displayOrder])
}

model GalleryAlbum {
  id       Int           @id @default(autoincrement())
  title    String
  category String? // event name / year
  coverUrl String?
  items    GalleryItem[]
}

model GalleryItem {
  id      Int          @id @default(autoincrement())
  albumId Int
  type    String       @default("IMAGE") // IMAGE | VIDEO
  url     String
  caption String?
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model StudentCornerPost {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  studentName String
  kind        String // ARTICLE | POEM | ARTWORK | ACHIEVEMENT
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([published, createdAt])
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  category  String   @default("GENERAL") // GENERAL | IT | ADMISSION
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Certificate {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  type          String // ENROLLMENT | ID_CARD | RESULT_SHEET | PROGRESS_REPORT | MARK_SHEET | COMPLETION | CHARACTER | TRANSFER_LETTER
  serial        String   @unique
  dataJson      String // snapshot of rendered data
  issuedAt      DateTime @default(now())
  student       User     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  // LMS: the exam a mark sheet or certificate was issued from, who issued it, and a revocation.
  // A revoked serial still verifies, as revoked, so a withdrawn paper copy cannot pass as valid.
  examId        Int?
  issuedById    Int?
  revokedAt     DateTime?
  revokedById   Int?
  revokeReason  String?

  @@index([studentUserId])
  @@index([examId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String?
  kind      String   @default("GENERAL") // GENERAL | ASSIGNMENT | REMINDER | QUESTION | IT | ADMIN
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Question {
  id            Int       @id @default(autoincrement())
  studentUserId Int
  teacherUserId Int?
  subject       String
  body          String
  answer        String?
  answeredAt    DateTime?
  createdAt     DateTime  @default(now())
  student       User      @relation("StudentQuestions", fields: [studentUserId], references: [id], onDelete: Cascade)
  teacher       User?     @relation("TeacherQuestions", fields: [teacherUserId], references: [id])

  @@index([studentUserId])
  @@index([teacherUserId, answeredAt])
}

model TeacherTask {
  id            Int       @id @default(autoincrement())
  teacherUserId Int
  title         String
  detail        String?
  done          Boolean   @default(false)
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  teacher       User      @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)

  @@index([teacherUserId, done])
}

model GoverningMember {
  id           Int     @id @default(autoincrement())
  kind         String // GOVERNING | REGIONAL
  name         String
  role         String // Chairman, Member-Secretary, Member, Regional Representative
  organization String?
  region       String?
  phone        String?
  email        String?
  photoUrl     String?
  bio          String?
  displayOrder Int     @default(100)

  @@index([kind, displayOrder])
}

model CurriculumEntry {
  id           Int     @id @default(autoincrement())
  classLevel   String // PRE_PRIMARY..CLASS_5
  subject      String
  details      String?
  displayOrder Int     @default(100)

  @@index([classLevel, displayOrder])
}

/**
 * A general class as the public site shows it (Academic > All General Classes): a card on the
 * class list and a page of its own listing the books taught. Content only - enrolment still
 * keys on CourseLevel and the classLevel strings.
 */
model AcademicClass {
  id             Int            @id @default(autoincrement())
  slug           String         @unique // pre-primary, class-1 ... - the page URL
  name           String // "Pre-Primary", "Class 1"
  ageRange       String? // "Age 3-5"
  summary        String? // the card's short text
  tagline        String? // the line under the title on the class page banner
  intro          String? // "What we offer" paragraph
  highlights     String[]       @default([]) // the short items beside the intro
  color          String         @default("green") // green | blue | purple | orange | teal | red | indigo
  cardImageUrl   String?
  bannerImageUrl String?
  displayOrder   Int            @default(100)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  subjects       ClassSubject[]

  @@index([active, displayOrder])
}

/**
 * One book or subject taught in an AcademicClass, added from the admin panel.
 */
model ClassSubject {
  id            Int           @id @default(autoincrement())
  classId       Int
  academicClass AcademicClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  title         String
  category      String        @default("MAIN") // MAIN | RELATED | HOMEWORK
  description   String?
  outcomes      String[]      @default([])
  coverImageUrl String?
  color         String        @default("pink") // pink | purple | blue | teal | green | yellow | orange | red | indigo
  displayOrder  Int           @default(100)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([classId, displayOrder])
}

model ProgressRecord {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  courseSlug    String // ielts-for-kids, abacus, ...
  label         String // "Mock Band – Listening", "Level 2 Assessment"
  score         String // "6.5", "85/100"
  note          String?
  recordedAt    DateTime @default(now())
  recordedById  Int?
  student       User     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, courseSlug])
}

model GameScore {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  game          String // balloon-pop | treasure-hunt | flash-race
  level         Int      @default(0)
  score         Int
  createdAt     DateTime @default(now())
  student       User     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, game])
}

model HifzProgress {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  surahNumber   Int // 1..114
  surahName     String
  juz           Int?
  completedAt   DateTime @default(now())
  student       User     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, surahNumber])
  @@index([studentUserId])
}

model ExamResult {
  id            Int     @id @default(autoincrement())
  studentUserId Int
  semester      String
  subject       String
  fullMarks     Int     @default(100)
  marks         Float // LMS B5: halves are allowed in exam marks
  grade         String?
  remark        String?
  // LMS B5: set on rows written by publishing an exam's results, so a withdrawal removes exactly
  // those; null on rows the office entered by hand.
  examId        Int?
  student       User    @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, semester, subject])
  @@index([studentUserId, semester])
  @@index([examId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // CONTENT_EDIT | ADMISSION_DECISION | PAYMENT_VERIFY | USER_CREATE | ...
  entity    String
  entityId  String?
  detail    String?
  ip        String? // the caller's address, where the action came through HTTP
  diff      Json? // { before, after } of the fields an edit changed
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
}

/**
 * SEC-8: rate-limit counters. Kept in the database rather than in memory because the app
 * runs on serverless — each instance has its own heap, so an in-memory limiter resets
 * constantly and protects nothing. One row per (bucket, window).
 */
model RateLimit {
  id        Int      @id @default(autoincrement())
  bucket    String // e.g. "login:203.0.113.9" or "apply:203.0.113.9"
  windowAt  DateTime // start of the fixed window this row counts
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([bucket, windowAt])
  @@index([windowAt])
}

model Setting {
  key   String @id // smtp_host, whatsapp_number, zoom_account, pg_client_key, stat_total_students, ...
  value String
}

/**
 * ---------------------------------- CRM ----------------------------------
 * Prospective-student pipeline, ported from lms_taiba. A Lead is kept after conversion
 * (stage ENROLLED, convertedApplicationId set) so funnel reporting stays intact.
 * Stage / outcome / lost-reason values are validated in leads.schema.ts, not as enums, to
 * match the rest of this schema (status columns are plain strings).
 */

model LeadSource {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String?
  description String?
  isPublic    Boolean  @default(false) // offered on the public enquiry form
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leads       Lead[]
}

model Lead {
  id                     Int              @id @default(autoincrement())
  leadNo                 String           @unique // LD-YYMM-NNNN
  name                   String
  email                  String?
  phone                  String?
  alternatePhone         String?
  gender                 String?
  city                   String?
  sourceId               Int?
  source                 LeadSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  campaign               String?
  referredBy             String?
  courseId               Int?
  course                 Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  stage                  String           @default("NEW") // NEW | CONTACTED | QUALIFIED | APPLIED | ADMITTED | ENROLLED | LOST
  lostReason             String?
  lostNote               String?
  score                  Int              @default(0)
  assignedToUserId       Int?
  assignedTo             User?            @relation("LeadOwner", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  lastContactedAt        DateTime?
  nextFollowUpAt         DateTime?
  convertedApplicationId Int?
  convertedApplication   ApplicationForm? @relation(fields: [convertedApplicationId], references: [id], onDelete: SetNull)
  convertedAt            DateTime?
  remarks                String?
  deletedAt              DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  activities             LeadActivity[]

  @@index([stage])
  @@index([assignedToUserId])
  @@index([nextFollowUpAt])
  @@index([email])
  @@index([phone])
}

model LeadActivity {
  id                Int       @id @default(autoincrement())
  leadId            Int
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type              String // CALL | EMAIL | SMS | WHATSAPP | MEETING | CAMPUS_VISIT | NOTE | STAGE_CHANGE | ASSIGNMENT
  subject           String
  notes             String?
  outcome           String? // REACHED | NO_ANSWER | CALLBACK_REQUESTED | NOT_INTERESTED | INFORMATION_SENT | COMPLETED
  scheduledAt       DateTime?
  completedAt       DateTime?
  performedByUserId Int?
  performedBy       User?     @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
  isSystemGenerated Boolean   @default(false)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([leadId])
  @@index([scheduledAt])
}

/**
 * Discount coupon, redeemed on the admission form. `PERCENT` takes `value` percent off the
 * fee total; `FIXED` takes `value` won off it. Books are not part of the total, so are not
 * discounted. Codes are stored upper-case.
 */
model Coupon {
  id           Int               @id @default(autoincrement())
  code         String            @unique
  description  String?
  discountType String // PERCENT | FIXED
  value        Int
  appliesTo    String            @default("ALL") // ALL | REGULAR | SPECIAL | RE_ADMISSION
  maxUses      Int? // null = unlimited; counted over applications that have not been rejected
  validFrom    DateTime?
  validUntil   DateTime?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  applications ApplicationForm[]
}

/**
 * A menu of one of the three panels (admin, teacher, student): one page-group whose four switches
 * (Access, Insert, Update, Delete) can be granted per user. Seeded by the migration with every
 * current menu and kept complete at startup (rows are inserted if missing, never overwritten, so
 * edits on the Menu entry screen survive). What an *admin* menu's switches grant is enforcement
 * logic and stays in code (common/menu-permissions.ts), deliberately not editable as data.
 */
model Menu {
  id           Int                  @id @default(autoincrement())
  key          String               @unique // stable identifier routes and grants refer to
  panel        String // ADMIN | TEACHER | STUDENT
  module       String // the group it appears under
  label        String
  href         String // the page it opens
  note         String?
  actions      String               @default("access") // comma list of the switches this menu offers (admin menus: derived from the capability map)
  displayOrder Int                  @default(0)
  active       Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  permissions  UserMenuPermission[]

  @@index([panel, displayOrder])
}

/**
 * Per-user permission on one menu (admin staff). A user with no rows here gets their role's
 * default permissions; a user with rows gets exactly what the grid grants, whatever the role
 * says. Saving the grid always writes a row for every menu, so "present but all false" is a
 * real, deliberate lock-down rather than being mistaken for "no custom setting".
 */
model UserMenuPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuId    Int
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  canAccess Boolean  @default(false)
  canInsert Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, menuId])
  @@index([menuId])
}
