// BCSK Platform data model (SRS §7)
// PostgreSQL — works with Vercel Postgres/Neon (deployment) and `npx prisma dev` (local).
// The types below are also MySQL-compatible if the school later self-hosts per the SRS.
// Role/status/type fields are strings validated against constants in src/lib/constants.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer) endpoint — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Unpooled endpoint — Prisma Migrate needs a direct session-mode connection,
  // which Neon's transaction-mode pooler cannot provide.
  directUrl = env("DIRECT_URL")
}

// Uploaded files live in the database so the app runs on serverless hosts
// (no writable filesystem on Vercel). Served role-checked via /api/files/[...path].
model FileBlob {
  path      String   @id // e.g. "applications/ab12cd.jpg"
  mime      String
  data      Bytes
  createdAt DateTime @default(now())
}

model User {
  id           Int       @id @default(autoincrement())
  loginId      String    @unique // Student ID / Teacher ID / Admin ID
  email        String?
  passwordHash String
  role         String // STUDENT | TEACHER | ADMIN_SUPPORT | IT_SUPPORT | SUPER_ADMIN
  name         String
  langPref     String    @default("en") // en | bn | ko
  active       Boolean   @default(true)
  // SEC-2: set on seeded/rotated/office-issued credentials. Every surface guard
  // diverts to /change-password until the holder sets their own password.
  mustChangePassword Boolean  @default(false)
  passwordChangedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  enrollments    Enrollment[]
  attendances    Attendance[]
  submissions    Submission[]
  payments       Payment[]        @relation("PayerPayments")
  verifiedPayments Payment[]      @relation("VerifierPayments")
  notifications  Notification[]
  questionsAsked Question[]       @relation("StudentQuestions")
  questionsRecv  Question[]       @relation("TeacherQuestions")
  teacherTasks   TeacherTask[]
  certificates   Certificate[]
  progressRecords ProgressRecord[]
  gameScores     GameScore[]
  hifzProgress   HifzProgress[]
  examResults    ExamResult[]
  auditLogs      AuditLog[]
  passwordResets PasswordReset[]
  refreshTokens  RefreshToken[]
}

/**
 * Phase F: refresh tokens for mobile clients.
 *
 * Stored **hashed** — a database leak must not yield usable credentials. Rotated on every
 * use; presenting an already-rotated token revokes the whole family, which is the standard
 * signal that a token was stolen.
 */
model RefreshToken {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  /** Groups rotations of one login, so a reuse can revoke every descendant. */
  familyId   String
  deviceName String?
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudentProfile {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique
  studentId         String   @unique // e.g. BCSK-2026-0001
  classLevel        String // PRE_PRIMARY | CLASS_1..CLASS_5 | SPECIAL
  photoUrl          String?
  dob               DateTime?
  gender            String?
  religion          String?
  fatherName        String?
  motherName        String?
  guardianProfession String?
  guardianEducation String?
  guardianPhone     String?
  guardianEmail     String?
  addressKorea      String?
  addressBangladesh String?
  emergencyContact  String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique
  teacherId   String  @unique // e.g. BCSK-T-001
  designation String?
  bio         String?
  photoUrl    String?
  guideClass  String? // guide-teacher class
  subjects    String? // comma-separated for display
  isPublic    Boolean @default(true) // show on public Teachers page
  displayOrder Int    @default(100)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  classSessions ClassSession[]
}

model Course {
  id          Int     @id @default(autoincrement())
  slug        String  @unique // bangla, english, math, abacus, ielts-for-kids, deen, debate-club, hifz, bangla-language
  name        String
  type        String // REGULAR | SPECIAL
  category    String? // subject | deen | ielts | abacus | debate
  description String?
  heroText    String?
  active      Boolean @default(true)
  displayOrder Int    @default(100)
  levels      CourseLevel[]
  sessions    ClassSession[]
}

model CourseLevel {
  id           Int     @id @default(autoincrement())
  courseId     Int
  name         String // "Level 0" .. "Level 7", "Pre-Primary", track names
  displayOrder Int     @default(0)
  syllabus     String? // markdown/plain topic coverage
  studentBookUrl String?
  workBookUrl  String?
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessions     ClassSession[]

  @@index([courseId, displayOrder])
}

model ClassSession {
  id           Int     @id @default(autoincrement())
  courseId     Int
  courseLevelId Int?
  title        String // e.g. "Level-0 Class-1", "Class 3 – Bangla"
  classLevel   String? // for regular classes: PRE_PRIMARY..CLASS_5
  dayOfWeek    String // e.g. "Saturday"
  startTime    String // "10:00"
  endTime      String? // "11:00"
  semester     String  @default("2026-2")
  teacherId    Int?
  zoomLink     String?
  isLive       Boolean @default(false)
  notice       String?
  active       Boolean @default(true)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  level        CourseLevel? @relation(fields: [courseLevelId], references: [id])
  teacher      TeacherProfile? @relation(fields: [teacherId], references: [id])
  enrollments  Enrollment[]
  attendances  Attendance[]
  assignments  Assignment[]
  videos       ClassVideo[]

  @@index([courseId])
  @@index([courseLevelId])
  @@index([teacherId])
  @@index([classLevel, semester, active])
  @@index([semester, active])
}

model Enrollment {
  id             Int      @id @default(autoincrement())
  studentUserId  Int
  classSessionId Int
  semester       String
  status         String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED
  createdAt      DateTime @default(now())
  student        User         @relation(fields: [studentUserId], references: [id], onDelete: Cascade)
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, classSessionId, semester])

  @@index([classSessionId])
  @@index([studentUserId, semester, status])
}

model Attendance {
  id             Int      @id @default(autoincrement())
  classSessionId Int
  studentUserId  Int
  date           DateTime
  status         String // PRESENT | ABSENT | LATE
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  student        User         @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([classSessionId, studentUserId, date])

  @@index([studentUserId, date])
}

model Assignment {
  id             Int      @id @default(autoincrement())
  classSessionId Int
  title          String
  description    String?
  fileUrl        String?
  dueDate        DateTime?
  createdAt      DateTime @default(now())
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)
  submissions    Submission[]

  @@index([classSessionId, createdAt])
}

model Submission {
  id            Int      @id @default(autoincrement())
  assignmentId  Int
  studentUserId Int
  fileUrl       String?
  text          String?
  submittedAt   DateTime @default(now())
  grade         String?
  feedback      String?
  gradedAt      DateTime?
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student       User       @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentUserId])

  @@index([studentUserId])
}

model ClassVideo {
  id             Int      @id @default(autoincrement())
  classSessionId Int
  title          String
  videoUrl       String // uploaded file or YouTube/Zoom recording link
  recordedAt     DateTime @default(now())
  classSession   ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Cascade)

  @@index([classSessionId, recordedAt])
}

model ApplicationForm {
  id               Int      @id @default(autoincrement())
  type             String // REGULAR | SPECIAL | RE_ADMISSION
  status           String   @default("PENDING_PAYMENT") // PENDING_PAYMENT | PENDING_VERIFICATION | PAID | APPROVED | REJECTED | CORRECTIONS_REQUESTED
  // shared applicant fields
  applicantName    String
  dob              DateTime?
  gender           String?
  religion         String?
  phone            String?
  email            String?
  photoUrl         String?
  addressKorea     String?
  addressBangladesh String?
  emergencyContact String?
  // regular course
  grade            String? // PRE_PRIMARY..CLASS_5
  fatherName       String?
  motherName       String?
  guardianProfession String?
  guardianEducation String?
  guardianPhone2   String?
  // special course
  courseName       String? // slug of special course
  highestEducation String?
  // SEC-3: the BCSK-student discount claim, persisted at submit time. The fee is derived
  // from this column and never from a request parameter.
  isBcskStudent    Boolean  @default(false)
  parentalConsent  Boolean  @default(false) // PIPA consent
  adminNote        String?
  correctionNote   String?
  createdStudentUserId Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  payments         Payment[]

  @@index([status, createdAt])
}

model Payment {
  id               Int      @id @default(autoincrement())
  applicationId    Int?
  payerUserId      Int? // for logged-in semester fee / re-admission payments
  purpose          String // ADMISSION | SEMESTER_FEE | SPECIAL_COURSE | RE_ADMISSION
  method           String // CARD | BANK_TRANSFER
  amount           Int // KRW
  currency         String   @default("KRW")
  status           String   @default("PENDING") // PENDING | PENDING_VERIFICATION | PAID | VERIFIED | REJECTED | REFUNDED | FAILED
  // SEC-7.1: unique so a replayed gateway callback cannot record the same capture twice.
  gatewayTxnId     String?  @unique // Toss paymentKey
  gatewayOrderId   String?  @unique
  virtualRef       String?  @unique // auto-generated bank reference
  receiptUploadUrl String? // uploaded bank receipt
  receiptPdfSerial String?  @unique // our issued receipt number
  rejectReason     String?
  verifiedById     Int?
  verifiedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  application      ApplicationForm? @relation(fields: [applicationId], references: [id])
  payer            User?            @relation("PayerPayments", fields: [payerUserId], references: [id])
  verifiedBy       User?            @relation("VerifierPayments", fields: [verifiedById], references: [id])

  @@index([applicationId])
  @@index([payerUserId])
  @@index([verifiedById])
  @@index([status, createdAt])
}

model FeeConfig {
  id           Int     @id @default(autoincrement())
  key          String  @unique // pre_primary, class_1..class_5, ielts_l1.., abacus, deen, debate_club
  label        String
  kind         String // REGULAR_CLASS | SPECIAL_COURSE
  admissionFee Int     @default(0)
  semesterFee  Int     @default(0)
  bcskPrice    Int? // special course price for BCSK students
  nonBcskPrice Int? // for non-BCSK students
  bookFee      Int?
  displayOrder Int     @default(100)
  active       Boolean @default(true)
}

model ContentPage {
  id          Int      @id @default(autoincrement())
  slug        String // about-us, education-process, admission-process, ...
  lang        String   @default("en") // en | bn | ko
  title       String
  content     String // markdown
  status      String   @default("PUBLISHED") // DRAFT | PUBLISHED
  updatedById Int?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([slug, lang])

  @@index([slug, status])
}

model EventNews {
  id        Int      @id @default(autoincrement())
  type      String // NEWS | SEMINAR | EVENT
  title     String
  body      String
  imageUrl  String?
  date      DateTime @default(now())
  published Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([published, date])
}

/**
 * The homepage hero slider. A flat, small (admin-capped at 5) list rather than a gallery
 * album — one purpose, one place, no nesting.
 */
model HeroImage {
  id           Int      @id @default(autoincrement())
  url          String
  caption      String?
  displayOrder Int      @default(100)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([active, displayOrder])
}

model GalleryAlbum {
  id       Int    @id @default(autoincrement())
  title    String
  category String? // event name / year
  coverUrl String?
  items    GalleryItem[]
}

model GalleryItem {
  id      Int     @id @default(autoincrement())
  albumId Int
  type    String  @default("IMAGE") // IMAGE | VIDEO
  url     String
  caption String?
  album   GalleryAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@index([albumId])
}

model StudentCornerPost {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  studentName String
  kind        String // ARTICLE | POEM | ARTWORK | ACHIEVEMENT
  imageUrl    String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([published, createdAt])
}

model SupportTicket {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  category  String   @default("GENERAL") // GENERAL | IT | ADMISSION
  status    String   @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  reply     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

model Certificate {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  type          String // ENROLLMENT | ID_CARD | RESULT_SHEET | PROGRESS_REPORT
  serial        String   @unique
  dataJson      String // snapshot of rendered data
  issuedAt      DateTime @default(now())
  student       User     @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  body      String?
  kind      String   @default("GENERAL") // GENERAL | ASSIGNMENT | REMINDER | QUESTION | IT | ADMIN
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

model Question {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  teacherUserId Int?
  subject       String
  body          String
  answer        String?
  answeredAt    DateTime?
  createdAt     DateTime @default(now())
  student       User  @relation("StudentQuestions", fields: [studentUserId], references: [id], onDelete: Cascade)
  teacher       User? @relation("TeacherQuestions", fields: [teacherUserId], references: [id])

  @@index([studentUserId])
  @@index([teacherUserId, answeredAt])
}

model TeacherTask {
  id            Int      @id @default(autoincrement())
  teacherUserId Int
  title         String
  detail        String?
  done          Boolean  @default(false)
  dueDate       DateTime?
  createdAt     DateTime @default(now())
  teacher       User @relation(fields: [teacherUserId], references: [id], onDelete: Cascade)

  @@index([teacherUserId, done])
}

model GoverningMember {
  id           Int     @id @default(autoincrement())
  kind         String // GOVERNING | REGIONAL
  name         String
  role         String // Chairman, Member-Secretary, Member, Regional Representative
  organization String?
  region       String?
  phone        String?
  email        String?
  photoUrl     String?
  bio          String?
  displayOrder Int     @default(100)

  @@index([kind, displayOrder])
}

model CurriculumEntry {
  id           Int    @id @default(autoincrement())
  classLevel   String // PRE_PRIMARY..CLASS_5
  subject      String
  details      String?
  displayOrder Int    @default(100)

  @@index([classLevel, displayOrder])
}

model ProgressRecord {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  courseSlug    String // ielts-for-kids, abacus, ...
  label         String // "Mock Band – Listening", "Level 2 Assessment"
  score         String // "6.5", "85/100"
  note          String?
  recordedAt    DateTime @default(now())
  recordedById  Int?
  student       User @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, courseSlug])
}

model GameScore {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  game          String // balloon-pop | treasure-hunt | flash-race
  level         Int      @default(0)
  score         Int
  createdAt     DateTime @default(now())
  student       User @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@index([studentUserId, game])
}

model HifzProgress {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  surahNumber   Int // 1..114
  surahName     String
  juz           Int?
  completedAt   DateTime @default(now())
  student       User @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, surahNumber])

  @@index([studentUserId])
}

model ExamResult {
  id            Int      @id @default(autoincrement())
  studentUserId Int
  semester      String
  subject       String
  fullMarks     Int      @default(100)
  marks         Int
  grade         String?
  remark        String?
  student       User @relation(fields: [studentUserId], references: [id], onDelete: Cascade)

  @@unique([studentUserId, semester, subject])

  @@index([studentUserId, semester])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String // CONTENT_EDIT | ADMISSION_DECISION | PAYMENT_VERIFY | USER_CREATE | ...
  entity    String
  entityId  String?
  detail    String?
  createdAt DateTime @default(now())
  user      User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([entity, entityId])
}

/**
 * SEC-8: rate-limit counters. Kept in the database rather than in memory because the app
 * runs on serverless — each instance has its own heap, so an in-memory limiter resets
 * constantly and protects nothing. One row per (bucket, window).
 */
model RateLimit {
  id        Int      @id @default(autoincrement())
  bucket    String // e.g. "login:203.0.113.9" or "apply:203.0.113.9"
  windowAt  DateTime // start of the fixed window this row counts
  count     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([bucket, windowAt])
  @@index([windowAt])
}

model Setting {
  key   String @id // smtp_host, whatsapp_number, zoom_account, pg_client_key, stat_total_students, ...
  value String
}
