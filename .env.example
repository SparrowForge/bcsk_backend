# ── BCSK Backend (NestJS) ──────────────────────────────────────────────────────
# Owns the database and every secret. The frontend receives no value from here.
NODE_ENV="development"
PORT="4000"

# API Configuration. Every route is served under ${API_PREFIX}/${API_VERSION}.
# Changing API_VERSION relocates the whole surface at once — ship a breaking change as v2
# while v1 keeps serving whatever mobile build is already installed. Blank falls back to
# api/v1; stray slashes are trimmed.
API_PREFIX=api
API_VERSION=v1

# Database — Neon Postgres. DIRECT_URL is the unpooled endpoint Prisma Migrate requires,
# because a transaction-mode pooler cannot serve DDL.
DATABASE_URL=""
DIRECT_URL=""

# Required, minimum 32 chars. The app refuses to boot without it (SEC-1) — there is no fallback.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
SESSION_HOURS="8"

# Web origins allowed to call this API with credentials. Never "*".
CORS_ORIGINS="http://localhost:3000"

TOSS_CLIENT_KEY=""
TOSS_SECRET_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BCSK <bcskr22@gmail.com>"

# Cloudinary — set all three or none. All three set means files are delivered from the CDN
# and CLOUDINARY_TOKEN_KEY below becomes mandatory; all three blank means every file is
# served from the database instead, which is how local development runs.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="bcsk"

# Token-based delivery for the folders that are not public (applications, receipts,
# submissions, student-docs, books, assignments, class-videos). REQUIRED whenever the three
# variables above are set: the app refuses to boot without it rather than fall back to a
# signed URL that never expires, because a Cloudinary signature covers only the delivery path
# — there is no such thing as a short-lived signed URL, only a short-lived token.
#
# Not your API secret, and not something you can generate: token-based access is an Advanced
# plan feature that Cloudinary support enables per product environment, and they send you the
# hex encryption key. The BCSK cloud was on the Free plan as of Sep 2026, so this cannot be
# filled in until the account is upgraded. A non-hex value also throws at startup, rather than
# minting tokens Cloudinary answers with 401.
CLOUDINARY_TOKEN_KEY=""
# Seconds a delivery token stays valid. Blank, zero or non-numeric falls back to 300.
CLOUDINARY_TOKEN_TTL="300"

# reCAPTCHA — set BOTH or NEITHER (SEC-9). Half-configured throws at startup.
RECAPTCHA_SECRET_KEY=""

WEB_BASE_URL="http://localhost:3000"
